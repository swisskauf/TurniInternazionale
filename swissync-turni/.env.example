# --- Server (Cloudflare Worker / dev server) ---------------------------
# Chiave API xAI (https://console.x.ai). Resta SOLO sul server: mai nel client.
XAI_API_KEY=
# Modello xAI (deve supportare input immagine + structured outputs)
XAI_MODEL=grok-4.7
# Endpoint compatibile OpenAI (lascia vuoto per api.x.ai)
XAI_BASE_URL=
# Sforzo di ragionamento: low | medium | high
XAI_REASONING=medium
# Richieste AI giornaliere per IP quando si usa la chiave del server
AI_DAILY_LIMIT=40
# Origini aggiuntive autorizzate (CORS), separate da virgola
ALLOWED_ORIGINS=

# --- Client --------------------------------------------------------------
# URL pubblico del backend per le app native (iOS/Android). Default: https://turni.swissync.org
# Sul web si usa sempre la stessa origine.
VITE_API_BASE=

# --- Account Swissync (Cloudflare Worker + D1) ---------------------------
# In sviluppo `npm run dev` usa un database SQLite locale (.dev/) e mostra i codici
# email a schermo. In produzione sono variabili/segreti del Worker (wrangler.toml).
TOKEN_SECRET=
RESEND_API_KEY=
MAIL_FROM=Swissync Turni <no-reply@swissync.org>
AI_MONTHLY_LIMIT=6
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=org.swissync.turni
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
